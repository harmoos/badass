#
# This is a sample network config, please uncomment lines to configure the network
#

# Uncomment this line to load custom interface files
# source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

# Static config for eth0
auto eth0
iface eth0 inet static
	address 10.0.0.1
	netmask 255.255.255.0
#	gateway 192.168.0.1
#	up echo nameserver 192.168.0.1 > /etc/resolv.conf

# DHCP config for eth0
#auto eth0
#iface eth0 inet dhcp
#	hostname msall-router-1

# Static config for eth1
auto eth1
iface eth1 inet manual
	post-up /sbin/ip link del vxlan10 2>/dev/null || true
	post-up /sbin/ip link del br0 2>/dev/null || true
	post-up /sbin/ip link add br0 type bridge
	post-up /sbin/ip link set br0 up
	#post-up /sbin/ip link add vxlan10 type vxlan id 10 local 10.0.0.1 remote 10.0.0.2 dev eth0 dstport 4789
	post-up /sbin/ip link add vxlan10 type vxlan id 10 local 10.0.0.1 group 239.1.1.1 dev eth0 dstport 4789
	post-up /sbin/ip link set vxlan10 up
	post-up /sbin/ip link set eth1 master br0
	post-up /sbin/ip link set vxlan10 master br0
